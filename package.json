{
  "name": "@thinkiac/module-svelte",
  "version": "0.1.0",
  "description": "Reusable Svelte 5 SSR, hydration, cache, widget and HMR engine for Logos runtimes",
  "main": "index.cjs",
  "types": "index.d.ts",
  "files": [
    "index.cjs",
    "src",
    "dist",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "index.d.ts",
    "lib",
    "runtime",
    "runtime-module.cjs",
    "compat"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:isolated": "node scripts/isolated.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "runtime": {
    "role": "module",
    "entry": "index.cjs"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "esbuild-svelte": "^0.9.0",
    "svelte": "5.57.3",
    "express": "^4.19.2",
    "mdsvex": "^0.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@thinkiac/module-http": "git+https://github.com/ThinkIac/http.git#3e81ba054b77b3990d7600cc0fc3b16d6d1b32d0",
    "@thinkiac/module-runtime-compat": "git+https://github.com/ThinkIac/runtime-compat.git#cdc7111e66614bb1ed4a80901b3363587b3e6f0a"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThinkIac/svelte.git"
  },
  "devDependencies": {
    "logostype": "git+https://github.com/ThinkIac/LogosType.git#acdcc6032ab94219e0d4a4d25b1538fb55fa19cf"
  }
}
